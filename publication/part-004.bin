  <script>(function(){
    function showPortableError(message){
      var root=document.getElementById('root');
      if(!root)return;
      root.innerHTML='';
      var box=document.createElement('div');
      box.style.cssText='max-width:720px;margin:10vh auto;padding:32px;border:1px solid #d8e1ee;border-top:6px solid #DF0A0E;border-radius:18px;font-family:Arial,sans-serif;color:#002065;background:#fff;box-shadow:0 18px 45px rgba(0,32,101,.12)';
      var title=document.createElement('strong');
      title.style.fontSize='24px';
      title.textContent='No se pudo iniciar el dashboard';
      var help=document.createElement('p');
      help.style.cssText='line-height:1.6;color:#365377';
      help.textContent='Abre el archivo descargado con Microsoft Edge o Google Chrome. Si ya lo hiciste, comunica este detalle: '+message;
      box.appendChild(title);box.appendChild(help);root.appendChild(box);
    }
    window.addEventListener('error',function(event){showPortableError(event.message||'error de inicio');});
    window.addEventListener('unhandledrejection',function(event){showPortableError(String(event.reason||'error de inicio'));});
  })();
